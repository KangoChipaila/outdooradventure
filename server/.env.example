# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=green_rock_outdoor_gear
PGUSER=postgres
PGPASSWORD=your_password_here

# Or use a connection string instead of the above (takes precedence):
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/green_rock_outdoor_gear

# Server
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173

# ── Cloudflare R2 (object storage for product images) ────────────────────────
# Find these in your Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=green-rock-products

# The public base URL for your R2 bucket.
# If using R2's built-in public URL:  https://pub-<hash>.r2.dev
# If using a custom domain:           https://images.yourdomain.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
