{
  "name": "green-rock-server",
  "version": "1.0.0",
  "description": "Green Rock Outdoor Gear – Node.js/TypeScript API server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "psql -d green_rock_outdoor_gear -f src/db/schema.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.637.0",
    "bcrypt": "2.4.3",
    "pg": "8.12.0"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/node": "20.14.10",
    "@types/pg": "8.11.6",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.3"
  }
}
